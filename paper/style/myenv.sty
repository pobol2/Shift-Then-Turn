%  MYENV.STY
%  Theorem-like environments
% ─────────────────────────────────────────────────────────────────────────────

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{myenv}[Theorem environments]

% ── Custom environment for algorithms ────────────────────────────────────────────────────────
% If you dont want a function just put empty input in #3, #4 and #6
% #1 : Label
% #2 : Title
% #3 : Function name
% #4 : Function input
% #5 : Algo
% #6 : Function output
\newenvironment{algo}[6]
{
\begin{algorithm}
\caption{#2}
\label{#1}
\begin{algorithmic}[1]
\ifx&#3&%
    % #3 is empty
    #5
\else
    % #3 is nonempty
    \Function{#3}{#4}
    #5
    \State \Return #6
    \EndFunction
\fi    
}
{
\end{algorithmic}
\end{algorithm}
}
% ── Theorem-like environments ────────────────────────────────────────────────
\RequirePackage{amsthm}
\theoremstyle{plain}
\newtheorem{proposition}{Proposition}
\newtheorem{corollary}{Corollary}
\newtheorem{lemma}{Lemma}
\theoremstyle{definition}
\newtheorem{definition}{Definition}
\newtheorem{assumption}{Assumption}
\theoremstyle{remark}
\newtheorem{remark}{Remark}
